  // Tuning sliders (Vehicle > Tuning > Powertrain)
  "variables":[
    ["name","type","unit","category","default","min","max","title","description"],
    ["$battery_kwh","range","kWh","Powertrain",9,0.5,30,"Battery capacity","Game balance: energy the battery holds. The real pack is 1.2 kWh (2 x 12 V 50 Ah). Raise it if the car runs flat too fast, lower it to run flat sooner."],
    ["$battery_charge","range","%","Powertrain",100,1,100,"Battery charge","Charge level when the car spawns. Set it low to test running out of power."],
  ],
  // ---- 2 x Yuasa YBX5053 (12 V, 50 Ah) in series = 24 V x 50 Ah = 1.2 kWh nominal ----
  "energyStorage":[
    ["type","name"],
    ["electricBattery","mainBattery"],
  ],
  "mainBattery":{
    "energyType":"electricEnergy",
    "batteryCapacity":"$battery_kwh",                          // kWh at full charge
    "startingCapacity":"$=$battery_kwh*$battery_charge/100",   // kWh when the car spawns
  },
  "powertrain":[
    ["type","name","inputName","inputIndex"],
    ["electricMotor","mainMotor","dummy",0],
    ["shaft","reduction","mainMotor",1,{"gearRatio":6.5}],
    ["differential","differential_R","reduction",1,{"diffType":"open","gearRatio":1}],
    ["shaft","wheelaxleRL","differential_R",1,{"connectedWheel":"RL","breakTriggerBeam":"axle_RL"}],
    ["shaft","wheelaxleRR","differential_R",2,{"connectedWheel":"RR","breakTriggerBeam":"axle_RR"}],
  ],
  "mainMotor":{
    // ~1 kW class 24 V motor
    "torque":[["rpm","torque"],[0,5],[2500,5],[3000,3.2],[3600,0]],
    "maxRPM":3600,
    "inertia":0.05,
    "friction":0.2,
    "dynamicFriction":0.0002,
    "electricalEfficiency":0.9,
    "energyStorage":"mainBattery",
    "torqueReactionNodes:":["s4lb","s4rb","s3cb"],
  },
  "controller":[
    ["fileName"],
    ["vehicleController"],
  ],
  "vehicleController":{
    "shiftLogicName":"electricMotor",
    "motorNames":["mainMotor"],
    "topSpeedLimitReverse":5,
    "defaultRegen":0,
    "brakeRegenCoef":0,
  },

  // ---- Cameras: press C in game to cycle (driver seat / front nose cam) ----
  "camerasInternal":[
    ["type","x","y","z","fov","id1:","id2:","id3:","id4:","id5:","id6:"],
    {"selfCollision":false},
    {"collision":false},
    // driver seat cam: eye position just in front of the headrest, looking forward.
    // Heavy node + very soft, well-damped beams = smooths out bumps (raise beamSpring if it feels too floaty).
    {"nodeWeight":4.0},
    {"beamSpring":4000,"beamDamp":300},
    ["driver",0.0,0.40,0.68,70,"s3lt","s3rt","s3ct","s4lt","s4rt","s4ct",{"beamDeform":5001000,"beamStrength":"FLT_MAX"}],
    // front cam: on top of the nose, looking forward
    {"nodeWeight":2.0},
    {"beamSpring":15000,"beamDamp":250},
    ["front",0.0,-1.00,0.47,75,"s1lt","s1rt","s1ct","s2lt","s2rt","s2ct",{"beamDeform":5001000,"beamStrength":"FLT_MAX"}],
  ],

